# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# ---- Browser-visible (safe to ship in the client bundle) ----
# Supabase project URL, e.g. https://abcdefgh.supabase.co
# The BARE project URL only -- no /rest/v1, no trailing path of any kind.
# supabase-js and functionsBaseUrl() both append their own path onto this, so
# a URL that already ends in /rest/v1/ silently doubles the segment and every
# request 400s with "Invalid path specified in request URL".
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key. RLS limits it to reading the roster.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Only set when Edge Functions are served from a non-default host
# (e.g. http://127.0.0.1:54321/functions/v1 when running `supabase start`).
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
# "true" fakes Deepgram in the browser so local dev burns no API credits.
NEXT_PUBLIC_MOCK_SPEECH=false

# ---- Server-side only. Never prefix these with NEXT_PUBLIC_. ----
# Used by scripts/seed.ts locally; set in Supabase project settings for functions.
SUPABASE_SERVICE_ROLE_KEY=
# Deepgram key. Only the token-minting Edge Function ever reads it.
# IMPORTANT: use a member / usage-only key, not an owner or admin key. The
# browser is handed a temporary token minted from this one, and Deepgram grants
# that token the same scopes as the key that minted it. Short-lived is not the
# same as harmless if the scopes are wide.
DEEPGRAM_API_KEY=
# Shared staff PIN gating /announce and /admin writes. Checked in the Edge
# Function only; never stored in localStorage. Six digits or more: wrong-PIN
# attempts are throttled per network, but a 4-digit PIN is still a small space.
STAFF_PIN=
# "true" makes the Edge Functions return canned Deepgram tokens/transcripts.
MOCK_SPEECH=false
